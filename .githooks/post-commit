#!/bin/sh

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
MEMORY_DIR="$PROJECT_ROOT/WeTravellers_MEMORY_BUNDLE_V4_2026-08-15"
MEMORY_ZIP="$PROJECT_ROOT/WeTravellers_MEMORY_BUNDLE_V4_2026-08-15.zip"
STATUS_FILE="$MEMORY_DIR/PROJECT_GIT_STATUS.md"

if [ ! -d "$MEMORY_DIR" ]; then
    echo "[WeTravellers] Memory bundle not found. Skipping."
    exit 0
fi

COMMIT_HASH="$(git rev-parse --short HEAD)"
COMMIT_MESSAGE="$(git log -1 --format=%s)"
COMMIT_DATE="$(git log -1 --format=%ci)"
BRANCH="$(git branch --show-current)"

cat > "$STATUS_FILE" <<STATUS
# WeTravellers — Automatic Project State

Updated automatically after Git commit.

## Latest Commit

- Branch: $BRANCH
- Commit: $COMMIT_HASH
- Message: $COMMIT_MESSAGE
- Date: $COMMIT_DATE

## Repository Status

\`\`\`
$(git status --short)
\`\`\`

## Recent Commits

\`\`\`
$(git log -10 --oneline --decorate)
\`\`\`

## Project Root

$PROJECT_ROOT

## Memory Bundle

This directory is automatically packaged after each commit.
STATUS

TEMP_ZIP="$MEMORY_ZIP.tmp"

rm -f "$TEMP_ZIP"

cd "$PROJECT_ROOT"

zip -qr "$TEMP_ZIP" "$(basename "$MEMORY_DIR")"

mv -f "$TEMP_ZIP" "$MEMORY_ZIP"

echo "[WeTravellers] Memory bundle updated."
echo "[WeTravellers] Commit: $COMMIT_HASH"
echo "[WeTravellers] ZIP: $MEMORY_ZIP"

exit 0

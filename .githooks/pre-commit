#!/bin/sh
set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
MEMORY_DIR="$PROJECT_ROOT/PROJECT_MEMORY"
MEMORY_ZIP="$PROJECT_ROOT/WeTravellers_PROJECT_MEMORY_SYSTEM.zip"
STATUS_FILE="$MEMORY_DIR/03_CURRENT_STATE.md"
GIT_STATUS_FILE="$MEMORY_DIR/09_AI_HANDOFF.md"

if [ ! -d "$MEMORY_DIR" ]; then
    echo "[WeTravellers] PROJECT_MEMORY not found. Skipping memory sync."
    exit 0
fi

BRANCH="$(git branch --show-current)"
RECENT_COMMITS="$(git log -10 --oneline --decorate 2>/dev/null || true)"
PROJECT_STATUS="$(git status --short)"

cat >> "$STATUS_FILE" <<STATUS

---
## Automatic Git Sync
- Branch: $BRANCH
- Last sync before commit
- Repository status captured automatically

### Recent commits
\`\`\`
$RECENT_COMMITS
\`\`\`

### Pending status
\`\`\`
$PROJECT_STATUS
\`\`\`
STATUS

cat >> "$GIT_STATUS_FILE" <<STATUS

---
## Automatic Git Sync
This handoff was synchronized automatically before the latest commit.

Branch: $BRANCH

Recent commits:
\`\`\`
$RECENT_COMMITS
\`\`\`
STATUS

cd "$PROJECT_ROOT"

TEMP_ZIP="$MEMORY_ZIP.tmp"

zip -qr "$TEMP_ZIP" "PROJECT_MEMORY"
mv -f "$TEMP_ZIP" "$MEMORY_ZIP"

git add "$MEMORY_DIR" "$MEMORY_ZIP"

echo "[WeTravellers] Memory state synchronized."
echo "[WeTravellers] Memory bundle prepared for commit."

exit 0

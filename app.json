{
  "expo": {
    "name": "We Travelers",
    "slug": "we-travelers-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.wetravelers.wetravelersapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "2cda0860-a4ea-4e0c-be60-ff27d57a8ade"
      }
    }
  }
}

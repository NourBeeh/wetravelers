{
  "name": "wetravellers-backend",
  "version": "1.0.0",
  "description": "WeTravellers Backend BFF - NestJS",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test": "jest"
  },
  "dependencies": {
    "@duffel/api": "^4.28.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.spec\\.ts$",
    "maxWorkers": 1,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    }
  }
}

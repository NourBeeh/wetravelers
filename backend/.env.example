# WeTravellers Backend — Phase 9 AI provider configuration.
#
# These are variable NAMES only. Never commit real secrets — provide values
# via the deployment environment / shell / secrets manager.

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible REST chat completions)
# ---------------------------------------------------------------------------

# REQUIRED at runtime for the real provider /ai/query.
# Without it the module still boots, but the endpoint returns 503.
AI_API_KEY=

# Optional. Defaults to: https://api.openai.com/v1
# Point it at any OpenAI-compatible endpoint (OpenRouter, Groq, DeepSeek, ...).
AI_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to: gpt-4o-mini
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Optional secondary provider (Phase 10C fallback policy)
# ---------------------------------------------------------------------------

# Empty or absent = no fallback; the primary provider's failure is returned.
# Supported value: mock
#
# Consulted ONLY for transient primary failures (network failure, timeout,
# HTTP 5xx, unusable completion). A 4xx, a validation error or a missing
# AI_API_KEY is never retried.
AI_FALLBACK_PROVIDER=

# ---------------------------------------------------------------------------
# PostgreSQL (Phase 11A local provisioning)
# ---------------------------------------------------------------------------

# All optional. When unset, src/config/database.config.ts falls back to the
# local development defaults shown after each name, which are exactly the
# values `docker-compose.yml` provisions — so `docker-compose up -d` followed
# by `npm start` works with no .env at all.
#
# Override these per environment; never commit a real password.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Defaults: DB_HOST=localhost  DB_PORT=5432
#           DB_USER=wetravellers  DB_PASSWORD=wetravellers

#           DB_NAME=wetravellers

# ---------------------------------------------------------------------------
# Duffel flight booking provider (server-side only)
# ---------------------------------------------------------------------------
# Required for Duffel API integration. Never commit real access tokens.
DUFFEL_ACCESS_TOKEN=
# Optional alias supported by code for backward compatibility:
# DUFFEL_API_KEY=
# WeTravellers Backend — Phase 9 AI provider configuration.
#
# These are variable NAMES only. Never commit real secrets — provide values
# via the deployment environment / shell / secrets manager.

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible REST chat completions)
# ---------------------------------------------------------------------------

# REQUIRED at runtime for the real provider /ai/query.
# Without it the module still boots, but the endpoint returns 503.
AI_API_KEY=

# Optional. Defaults to: https://api.openai.com/v1
# Point it at any OpenAI-compatible endpoint (OpenRouter, Groq, DeepSeek, ...).
AI_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to: gpt-4o-mini
AI_MODEL=gpt-4o-mini